# Job Hunt OS: environment template. Copy the values you need into the right place and NEVER commit real ones.
#   apps/api/.env  -> the API (local dev)          .env.local -> your personal reference values (gitignored)
#   Vercel / Railway dashboards or CLI -> the hosted services

# ───────────── API (apps/api/.env; on Vercel project "job-hunt-os-api") ─────────────
# Use distinct databases per environment.
MONGODB_URI=mongodb://127.0.0.1:27017/job_hunt_os_dev
# Submit-only key used by the relay / Railway worker / importer.
AGENT_API_KEY=replace-with-a-long-random-value
# Separate key for the desktop app's sync and decisions. Never give this to the agent or worker.
API_PORT=8787
# Use 0.0.0.0 behind a platform proxy (Railway, Render, Fly). Keep 127.0.0.1 behind local Nginx.
API_HOST=127.0.0.1
# Extra browser origins allowed to call /v1/desktop (comma separated). Tauri and localhost:1420 are built in.
DESKTOP_ORIGINS=
# OneDrive workbook mirror for Company Intelligence (server-only Graph item IDs).
COMPANY_INTELLIGENCE_DRIVE_ID=
COMPANY_INTELLIGENCE_WORKBOOK_ITEM_ID=
GATE_DISCOVERY_URL=https://gate-discovery.4cyberlord.workers.dev

# ───────────── Desktop app ─────────────
# Pasted in the app: Settings -> AI Agent. The URL defaults to the hosted API.
DESKTOP_API_URL=https://job-hunt-os-api.vercel.app

# ───────────── Vercel relay (project "gate-telegram-relay") ─────────────
GATE_API_URL=https://job-hunt-os-api.vercel.app
# AGENT_API_KEY must also be set on the relay project (same value as the API's).
TELEGRAM_BOT_TOKEN=replace-with-bot-token-from-BotFather
TELEGRAM_CHAT_ID=replace-with-channel-id
# Optional: when set, POST /api/gate requires "Authorization: Bearer <token>" (set it on the Railway worker too).
GATE_INGEST_TOKEN=
# Optional: protects /api/retry; Vercel's cron sends it automatically.
CRON_SECRET=
GATE_TZ=America/Chicago

# ───────────── Railway worker (project "gate-telegram-backfill", service "gate-backfill-worker") ─────────────
# Railway fills the RAILWAY_* reference variables itself; real IDs live in .env.local.
# Variables you set on the service:
RELAY_URL=https://gate-telegram-relay.vercel.app/api/gate
# JSON array of discovered opportunities to post, one request each (see docs/GATE.md for the shape).
BACKFILL_JSON=[]
