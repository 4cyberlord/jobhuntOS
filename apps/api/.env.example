# Copy this file to .env in this directory, then replace every placeholder.
MONGODB_URI=mongodb://127.0.0.1:27017/job_hunt_os_dev
AGENT_API_KEY=generate-a-long-random-agent-key
API_PORT=8787
# optional comma-separated extra origins allowed to call /v1/desktop (CORS)
DESKTOP_ORIGINS=
# Server-owned Outlook sync. Register this redirect URL in Microsoft Entra, then set these only on the API host.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8787/v1/desktop/outlook/callback
# 32 random bytes, encoded as base64, or 64 hexadecimal characters. Never expose this to the desktop.
OUTLOOK_TOKEN_ENCRYPTION_KEY=
# Protects the five-minute scheduler endpoint (use a separate random value).
CRON_SECRET=
# OneDrive workbook mirror for GATE Company Intelligence. The Microsoft connection must consent to Files.ReadWrite.
COMPANY_INTELLIGENCE_DRIVE_ID=
COMPANY_INTELLIGENCE_WORKBOOK_ITEM_ID=
# Optional override for the Cloudflare Company Intelligence feed.
GATE_DISCOVERY_URL=https://gate-discovery.4cyberlord.workers.dev
# Railway bridge importer. These are server-only: neither the desktop nor Cloudflare receives GATE_INGEST_TOKEN.
GATE_BRIDGE_URL=
GATE_INGEST_TOKEN=
GATE_BRIDGE_CRON_SECRET=
API_HOST=127.0.0.1
